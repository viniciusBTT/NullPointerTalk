# Copie para .env (git-ignorado) e ajuste os valores antes de subir o docker-compose.
# Em dev local os defaults abaixo já batem com application.properties.
# Na VPS, troque tudo e replique LIVEKIT_API_KEY/LIVEKIT_API_SECRET em application-vps.properties.

POSTGRES_DB=nullpointertalk
POSTGRES_USER=nullpointertalk
POSTGRES_PASSWORD=nullpointertalk

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_local_apenas_para_desenvolvimento_32

# Em dev local deixe vazio (usa application.properties). Na VPS, defina "vps"
# pra ativar application-vps.properties (livekit.url publico via nginx/TLS).
SPRING_PROFILES_ACTIVE=
